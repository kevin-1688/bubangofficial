# ════════════════════════════════════════════════════
# BǑ-BĀNG 無望 — Environment Variables
# Copy this to .env.local for local dev
# Set these in: Vercel Dashboard > Project > Settings > Environment Variables
# NEVER commit .env.local to git
# ════════════════════════════════════════════════════

# Supabase — from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGc...   # Service Role key (secret — never use anon key here)

# CORS — your production domain
ALLOWED_ORIGIN=https://bubangofficial.vercel.app

# IP hash salt — any random string, keeps IP hashing unique to your project
IP_HASH_SALT=change-this-to-something-random-32chars
